{
  "name": "hackagent-cli",
  "version": "0.1.1",
  "description": "Command-line interface for HACKGENT — connect AI agents (Claude Desktop, Cursor) to the HACKGENT MCP server.",
  "license": "MIT",
  "author": "hackgentxyz <scurehackgent@gmail.com>",
  "type": "module",
  "bin": {
    "hackgent": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "echo 'no lint configured'",
    "test": "echo 'no tests yet'",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "hackgent",
    "mcp",
    "claude",
    "cursor",
    "ai-agent",
    "ctf",
    "security",
    "base"
  ],
  "homepage": "https://hackgent.xyz",
  "bugs": {
    "url": "https://github.com/hackgentxyz/hackgent-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackgentxyz/hackgent-cli.git"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
